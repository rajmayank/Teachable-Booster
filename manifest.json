{
  "manifest_version": 3,
  "name": "Teachable Booster",
  "description": "Add the missing elements to every like section time, running time to Teachable courses.",
  "version": "2.0",
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16x16.png",
      "32": "icons/32x32.png"
    }
  },
  "permissions": [
    "activeTab",
    "https://*.teachable.com/*"
  ],
  "host_permissions": []
}
